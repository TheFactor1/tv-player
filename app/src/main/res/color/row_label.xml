<?xml version="1.0" encoding="utf-8"?>
<!-- Panel rows turn solid white on focus, so their text and icons flip to dark with them. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/on_focus" android:state_focused="true" />
    <item android:color="@color/ink" />
</selector>

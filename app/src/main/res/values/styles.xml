<resources>
    <style name="ControlButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/control_button_bg</item>
        <item name="android:stateListAnimator">@animator/control_button_state</item>
        <item name="android:alpha">0.72</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>

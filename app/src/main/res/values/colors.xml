<resources>
    <!-- Cinema palette. Chrome is monochrome; the gold accent is kept for the home screen only. -->
    <color name="ink">#F3F1EC</color>
    <color name="ink_soft">#D9F3F1EC</color>
    <color name="ink_secondary">#C9CDD3</color>
    <color name="ink_dim">#99F3F1EC</color>
    <color name="ink_faint">#61F3F1EC</color>
    <color name="ink_quiet">#8B929C</color>
    <color name="accent">#E9C46A</color>
    <color name="ground">#0B0C0E</color>
    <color name="loading_ground">#05060A</color>
    <color name="panel_ground">#F00A0A0C</color>
    <!-- Behind the pause screen when there is no art: the frozen frame, dimmed. -->
    <color name="pause_veil">#C7000000</color>
    <!-- Focus is a solid fill with dark content on it, the way Apple TV does it; it reads on any projector. -->
    <color name="focus_fill">@color/ink</color>
    <color name="on_focus">#0B0C0E</color>
    <color name="on_focus_secondary">#4A4E55</color>
    <color name="hairline">#1FF3F1EC</color>
    <color name="control_rest_fill">#1FFFFFFF</color>
    <color name="card_ground">#15171A</color>
    <color name="panel_scrim">#59000000</color>
    <!-- Mercury, the Home's look: graphite and colourless glass. Blue only for the meniscus, focus and NEW; amber only for attention. -->
    <color name="mercury_fg">#ECEEF1</color>
    <color name="mercury_muted">#A3A8B0</color>
    <color name="mercury_faint">#1FECEEF1</color>
    <color name="mercury_blue">#9FB4FF</color>
    <color name="mercury_amber">#E0A446</color>
    <!-- The glass sheet's tint over its blur, and the plain panel where there is no blur. -->
    <color name="mercury_glass">#A30B0C0E</color>
    <color name="mercury_glass_plain">#990B0C0E</color>
    <!-- The one chrome line along the top of glass. -->
    <color name="mercury_chrome">#8CECEEF1</color>
    <color name="mercury_hover">#0FECEEF1</color>
</resources>

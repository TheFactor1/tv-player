<?xml version="1.0" encoding="utf-8"?>
<!-- Shades the backdrop on the left, where the film's details sit, and along the bottom for Recently played. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#EB0B0C0E" android:centerColor="#8C0B0C0E" android:centerX="0.42" android:endColor="#000B0C0E" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#FF0B0C0E" android:centerColor="#D90B0C0E" android:centerY="0.3" android:endColor="#000B0C0E" />
        </shape>
    </item>
</layer-list>

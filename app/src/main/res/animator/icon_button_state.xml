<?xml version="1.0" encoding="utf-8"?>
<!-- Focus grows a round control a little; transform only, so the GPU does it for free. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="180" android:propertyName="scaleX" android:valueTo="1.12" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:duration="180" android:propertyName="scaleY" android:valueTo="1.12" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="180" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:duration="180" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
        </set>
    </item>
</selector>

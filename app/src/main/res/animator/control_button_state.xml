<?xml version="1.0" encoding="utf-8"?>
<!-- Focus lifts a button slightly and brings it to full strength; only transform and alpha change, which the GPU does for free. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1.06" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1.06" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:duration="160" android:propertyName="alpha" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:duration="160" android:propertyName="alpha" android:valueTo="0.72" android:valueType="floatType" />
        </set>
    </item>
</selector>

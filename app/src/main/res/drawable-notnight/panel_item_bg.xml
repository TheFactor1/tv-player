<?xml version="1.0" encoding="utf-8"?>
<!-- Broadsheet rows read like a listings column: a hairline under each, solid ink when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/focus_fill" /></shape>
    </item>
    <item>
        <layer-list>
            <item android:gravity="bottom|fill_horizontal" android:height="1dp">
                <shape><solid android:color="@color/hairline" /></shape>
            </item>
        </layer-list>
    </item>
</selector>

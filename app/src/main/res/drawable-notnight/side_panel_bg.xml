    <item><shape><solid android:color="#F4EFE4" /></shape></item>
    <item android:gravity="start|fill_vertical" android:width="1dp"><shape><solid android:color="#1A1714" /></shape></item>
    <item android:gravity="start|fill_vertical" android:width="1dp" android:left="3dp"><shape><solid android:color="#1A1714" /></shape></item>
</layer-list>

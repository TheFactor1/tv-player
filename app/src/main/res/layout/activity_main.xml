<?xml version="1.0" encoding="utf-8"?>
<!-- Home, the Programme layout: text tabs along the top, the list on the left over a long fade, the
     focused title's backdrop on the right, Play and Details bottom-right. The title page, Search,
     the Refine sheet and the hub setup card are drawn over it; settings and Other versions use the
     side panel at the end. Rows and tabs are built in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <!-- Two layers, so one title's art crossfades into the next. -->
    <ImageView
        android:id="@+id/home_art_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/home_art_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/home_fade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/home_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/home_message"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginTop="116dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/mercury_muted"
            android:textSize="13sp" />

        <!-- Width is 46 % of the screen, set in code. -->
        <ScrollView
            android:id="@+id/home_scroll"
            android:layout_width="440dp"
            android:layout_height="match_parent"
            android:layout_marginTop="104dp"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="34dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="160dp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/home_pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="34dp"
            android:layout_marginBottom="29dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_play"
                style="@style/ControlButton"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/home_play"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/home_details"
                style="@style/ControlButton"
                android:layout_height="40dp"
                android:layout_marginEnd="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/home_details"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/home_keep"
                style="@style/ControlButton"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/home_keep"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- The title page (Details) and Search, built in code. -->
    <FrameLayout
        android:id="@+id/home_title_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/home_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/home_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <!-- Browse: the hub's catalogs as a second row of tabs. -->
    <HorizontalScrollView
        android:id="@+id/home_catalogs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:clipToPadding="false"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/home_catalogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- No hub yet, or a new address: the field, and where the phone will help later. -->
    <LinearLayout
        android:id="@+id/home_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/setup_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="@string/setup_kicker"
                android:textColor="@color/mercury_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/setup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="-0.03"
                android:text="@string/setup_title"
                android:textColor="@color/mercury_fg"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/setup_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/setup_body"
                android:textColor="@color/mercury_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/setup_address"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/mercury_muted"
                android:hint="@string/hub_address"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/mercury_fg"
                android:textColorHint="@color/ink_faint"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/setup_code"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/mercury_muted"
                android:hint="@string/setup_code"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:singleLine="true"
                android:textColor="@color/mercury_fg"
                android:textColorHint="@color/ink_faint"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/setup_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="18dp"
                android:textColor="@color/mercury_amber"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/setup_connect"
                    style="@style/ControlButton"
                    android:layout_height="44dp"
                    android:text="@string/setup_connect"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/setup_settings"
                    style="@style/ControlButton"
                    android:layout_height="44dp"
                    android:text="@string/home_settings"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- shortcut: an empty frame, and the address is typed, until hub discovery and the phone page exist; then a QR code to that page. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <View
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:background="@drawable/mercury_chip" />

            <TextView
                android:id="@+id/setup_qr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.2"
                android:text="@string/setup_qr"
                android:textColor="@color/mercury_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Refine: a glass sheet over the right of the screen; its width (38 %) is set in code. -->
    <FrameLayout
        android:id="@+id/home_refine"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:visibility="invisible" />

    <View
        android:id="@+id/panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/panel_scrim"
        android:visibility="gone" />

    <!-- Settings and Other versions: the same one-line list as the player's menus. -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="470dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/side_panel_bg"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="40dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/settings_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_kicker"
            android:textColor="@color/mercury_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdge="none"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/hairline" />

        <TextView
            android:id="@+id/settings_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>

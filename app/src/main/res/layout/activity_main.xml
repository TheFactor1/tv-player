<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: the last film played, full screen with its art, Recently played along the bottom,
     and the settings for every video in a side panel like the player's. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <ImageView
        android:id="@+id/home_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/home_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_scrim" />

    <!-- The film: kicker, logo or title, details, how far in, and what to do next. -->
    <LinearLayout
        android:id="@+id/home_hero"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/home_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="400dp"
            android:maxHeight="104dp"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:shadowColor="#73000000"
            android:shadowRadius="24"
            android:textColor="@color/ink"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/home_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:textColor="@color/ink_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="2"
            android:textColor="@color/ink_secondary"
            android:textSize="14.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/home_progress"
                android:layout_width="@dimen/home_progress_width"
                android:layout_height="3dp"
                android:background="@drawable/home_progress_track">

                <View
                    android:id="@+id/home_progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/home_progress_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/home_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink_secondary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- Starts the saved stream here; the source app's button is the way back when it won't. -->
            <TextView
                android:id="@+id/home_play"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/control_button_bg"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/control_icon"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:textColor="@color/control_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_continue"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/control_button_bg"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/control_icon"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:textColor="@color/control_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/home_settings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/control_button_bg"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/home_settings"
                android:textColor="@color/control_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_shelf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="22dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:letterSpacing="0.12"
            android:text="@string/home_recent"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp" />

        <!-- Each card carries the room for its own focus ring, so the cards line up with the label at
             56 dp less that room, and the padding is only for the slight lift. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fadingEdge="none"
            android:paddingStart="51.5dp"
            android:paddingTop="5.5dp"
            android:paddingEnd="51.5dp"
            android:paddingBottom="7.5dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_cards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Before anything has been played. -->
    <LinearLayout
        android:id="@+id/home_empty"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_marginStart="56dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_empty_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/home_kicker"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/home_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_title"
            android:textColor="@color/ink"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/home_empty_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/home_body"
            android:textColor="@color/ink_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/home_empty_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/ink_secondary"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/home_empty_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/control_button_bg"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/home_settings"
            android:textColor="@color/control_text"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/panel_scrim"
        android:visibility="gone" />

    <!-- Settings: the same one-line list as the player's menus, ending with what this TV can do. -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="470dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/side_panel_bg"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="40dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/settings_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_kicker"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdge="none"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/hairline" />

        <TextView
            android:id="@+id/settings_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: the last film played, full screen with its art, Recently played along the bottom,
     and the settings for every video over it, with a preview of what each one does. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <ImageView
        android:id="@+id/home_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/home_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_scrim" />

    <!-- The film: kicker, logo or title, details, how far in, and what to do next. -->
    <LinearLayout
        android:id="@+id/home_hero"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/home_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="400dp"
            android:maxHeight="104dp"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:shadowColor="#73000000"
            android:shadowRadius="24"
            android:textColor="@color/ink"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/home_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:textColor="@color/ink_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/home_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="2"
            android:textColor="@color/ink_secondary"
            android:textSize="14.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/home_progress"
                android:layout_width="@dimen/home_progress_width"
                android:layout_height="3dp"
                android:background="@drawable/home_progress_track">

                <View
                    android:id="@+id/home_progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/home_progress_fill" />
            </FrameLayout>

            <TextView
                android:id="@+id/home_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink_secondary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_continue"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/control_button_bg"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="10dp"
                android:drawableTint="@color/control_icon"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:textColor="@color/control_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/home_settings"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/control_button_bg"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/home_settings"
                android:textColor="@color/control_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_shelf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="22dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_recent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:letterSpacing="0.12"
            android:text="@string/home_recent"
            android:textColor="@color/ink_secondary"
            android:textSize="12sp" />

        <!-- Padded so a focused card's frame and lift have room inside the scroller. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fadingEdge="none"
            android:paddingStart="50dp"
            android:paddingTop="4dp"
            android:paddingEnd="50dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/home_cards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:padding="6dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Before anything has been played. -->
    <LinearLayout
        android:id="@+id/home_empty"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_marginStart="56dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_empty_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/home_kicker"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/home_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_title"
            android:textColor="@color/ink"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/home_empty_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/home_body"
            android:textColor="@color/ink_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/home_empty_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/ink_secondary"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/home_empty_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/control_button_bg"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/home_settings"
            android:textColor="@color/control_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Settings over the whole screen, the film's art dimmed behind: on the left a scene of what the
         focused setting does, on the right a short list. Pages one step in replace the list. -->
    <FrameLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/settings_veil"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="64dp"
            android:paddingEnd="56dp">

            <!-- Left out on a phone held upright, where the list needs the whole width. -->
            <LinearLayout
                android:id="@+id/settings_preview_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="30dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="96dp">

                <com.thefactor1.player.ui.AspectFrame
                    android:id="@+id/settings_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/settings_preview_bg"
                    android:importantForAccessibility="noHideDescendants">

                    <com.thefactor1.player.ui.AspectFrame
                        android:id="@+id/settings_preview_film"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical">

                        <ImageView
                            android:id="@+id/settings_preview_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </com.thefactor1.player.ui.AspectFrame>

                    <androidx.media3.ui.SubtitleView
                        android:id="@+id/settings_preview_subtitles"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0" />

                    <FrameLayout
                        android:id="@+id/settings_preview_sound"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@color/sound_ground"
                        android:paddingStart="24dp"
                        android:paddingTop="44dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="44dp">

                        <com.thefactor1.player.ui.SoundBars
                            android:id="@+id/settings_preview_bars"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </com.thefactor1.player.ui.AspectFrame>

                <TextView
                    android:id="@+id/settings_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/ink"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/settings_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="3"
                    android:textColor="@color/ink_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="24dp">

                <!-- The page Back returns to; empty on the first page. -->
                <TextView
                    android:id="@+id/settings_crumb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="18dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/settings_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.01"
                    android:paddingStart="16dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="18dp"
                    android:text="@string/settings_title"
                    android:textColor="@color/ink"
                    android:textSize="26sp" />

                <ScrollView
                    android:id="@+id/settings_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fadingEdge="none"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/settings_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Home, the Shelf layout: one header band, then on Home the focused title's hero over its backdrop
     with rows of posters under it, and on every other tab a grid of posters. The title page, Search,
     the Refine and Other versions sheets and the first-run screen are drawn over it; settings use
     the side panel at the end. Rows, cards and the header are built in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <!-- Two layers, so one title's art crossfades into the next. -->
    <ImageView
        android:id="@+id/home_art_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/home_art_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/home_fade"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/home_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Home: the focused title, over its backdrop. -->
        <LinearLayout
            android:id="@+id/home_hero"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tv_safe_x"
            android:layout_marginTop="68dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_hero_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:textColor="@color/mercury_blue"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/home_hero_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="340dp"
                android:maxHeight="56dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mercury_fg"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/home_hero_credits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:textColor="@color/mercury_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/home_hero_overview"
                android:layout_width="440dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.8"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:minLines="2"
                android:textColor="@color/mercury_fg"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/home_hero_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_play"
                    style="@style/ControlButton"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/home_play"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/home_details"
                    style="@style/ControlButton"
                    android:layout_height="38dp"
                    android:layout_marginEnd="0dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/home_details"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Home: rows of posters; the focused row rises to sit just under the hero. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="284dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="260dp"
            android:scrollbars="none" />

        <!-- Every other tab: Browse's catalogs and what the filters are doing, over a grid. -->
        <LinearLayout
            android:id="@+id/home_grid_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/tv_safe_x"
            android:paddingEnd="@dimen/tv_safe_x"
            android:visibility="gone">

            <HorizontalScrollView
                android:id="@+id/home_catalogs_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/home_catalogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/home_whisper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.16"
                android:textColor="@color/mercury_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="96dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/tv_safe_y"
            android:scrollbars="none"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_message"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tv_safe_x"
            android:layout_marginTop="300dp"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/mercury_muted"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- The title page (Details) and Search, built in code. -->
    <FrameLayout
        android:id="@+id/home_title_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/home_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="76dp"
        android:visibility="gone" />

    <!-- The header band; built in code (Header). -->
    <FrameLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_safe_x"
        android:layout_marginTop="@dimen/tv_safe_y"
        android:layout_marginEnd="@dimen/tv_safe_x" />

    <!-- First run: finding the hub and pairing with a code, built in code (PairingSetup). -->
    <FrameLayout
        android:id="@+id/home_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ground"
        android:visibility="gone" />

    <!-- Refine: a glass sheet over the right of the screen; its width (38 %) is set in code. -->
    <FrameLayout
        android:id="@+id/home_refine"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:visibility="invisible" />

    <!-- Other versions: the same glass sheet as Refine; its width is set in code. -->
    <FrameLayout
        android:id="@+id/home_versions"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:focusable="true"
        android:visibility="invisible" />

    <View
        android:id="@+id/panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/panel_scrim"
        android:visibility="gone" />

    <!-- Settings and Other versions: the same one-line list as the player's menus. -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="470dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/side_panel_bg"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/tv_safe_x"
        android:paddingBottom="@dimen/tv_safe_y"
        android:visibility="invisible">

        <TextView
            android:id="@+id/settings_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/settings_kicker"
            android:textColor="@color/mercury_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/settings_title"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdge="none"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/hairline" />

        <TextView
            android:id="@+id/settings_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- While a play is on its way to the hub: the screen dims and holds still. -->
    <View
        android:id="@+id/home_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#4D000000"
        android:clickable="true"
        android:visibility="gone" />
</FrameLayout>

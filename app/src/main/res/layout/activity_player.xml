<?xml version="1.0" encoding="utf-8"?>
<!-- Step 1 uses Media3's stock controller; the Cinema overlay replaces it in step 3.
     surface_type stays surface_view so HDR and Dolby Vision metadata reach the display untouched. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:surface_type="surface_view" />

    <TextView
        android:id="@+id/stats_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="32dp"
        android:background="@drawable/stats_background"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:textColor="#D7DBE0"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>

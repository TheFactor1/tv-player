<?xml version="1.0" encoding="utf-8"?>
<!-- One screen, layered: video, info bar, control bar, side panel, skip feedback, toast, stats, and the
     meta screen (film art and details) that serves as both the loading card and the pause screen.
     The video stays on a SurfaceView so HDR and Dolby Vision metadata reach the display untouched. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- Phones only: takes the taps, double taps and swipes that land on the picture. -->
    <View
        android:id="@+id/touch_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@drawable/scrim_top"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingTop="40dp"
        android:paddingEnd="64dp"
        android:paddingBottom="100dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:textColor="@color/ink_dim"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/ends_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:background="@drawable/scrim_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="120dp"
        android:paddingEnd="64dp"
        android:paddingBottom="24dp"
        android:visibility="invisible">

        <!-- The first Up shows only this: the bar and its times. It sits where the buttons would, and
             makes room for them when a second press asks for the rest. -->
        <LinearLayout
            android:id="@+id/seek_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

        <com.thefactor1.player.ui.SeekBarView
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="-13dp"
            android:layout_marginEnd="-13dp"
            android:focusable="true"
            android:nextFocusDown="@+id/btn_play" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:textColor="@color/ink_dim"
                android:textSize="14sp" />
        </LinearLayout>
        </LinearLayout>

        <!-- The buttons, over one white disc that glides to whichever has focus. -->
        <FrameLayout
            android:id="@+id/button_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipChildren="false"
            android:clipToPadding="false">

        <View
            android:id="@+id/button_glide"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/glide_disc"
            android:scaleX="1.12"
            android:scaleY="1.12"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/button_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_play"
                style="@style/IconButton"
                android:contentDescription="@string/control_pause"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusUp="@id/seek_bar"
                android:src="@drawable/ic_pause" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                android:background="#2EF3F1EC" />

            <ImageView
                android:id="@+id/btn_audio"
                style="@style/IconButton"
                android:contentDescription="@string/control_audio"
                android:nextFocusUp="@id/seek_bar"
                android:src="@drawable/ic_audio" />

            <ImageView
                android:id="@+id/btn_subtitles"
                style="@style/IconButton"
                android:contentDescription="@string/control_subtitles"
                android:nextFocusUp="@id/seek_bar"
                android:src="@drawable/ic_subtitles" />

            <ImageView
                android:id="@+id/btn_picture"
                style="@style/IconButton"
                android:contentDescription="@string/control_picture"
                android:nextFocusUp="@id/seek_bar"
                android:src="@drawable/ic_picture" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_more"
                style="@style/IconButton"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/control_more"
                android:nextFocusRight="@id/btn_more"
                android:nextFocusUp="@id/seek_bar"
                android:src="@drawable/ic_more" />
        </LinearLayout>
        </FrameLayout>

        <!-- One label for the whole row, slid under whichever button has focus. -->
        <FrameLayout
            android:id="@+id/label_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false">

            <TextView
                android:id="@+id/focus_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- A menu: a small card that opens over the button that opened it, only as tall as its rows. -->
    <LinearLayout
        android:id="@+id/side_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="@drawable/popup_bg"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="invisible">

        <!-- Only one level down, as the way back: "SUBTITLES" above "OpenSubtitles". -->
        <TextView
            android:id="@+id/panel_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:letterSpacing="0.1"
            android:textColor="@color/ink_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/ink"
            android:textSize="17sp"
            android:visibility="gone" />

        <com.thefactor1.player.ui.MaxHeightScrollView
            android:id="@+id/panel_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- The focus highlight, gliding from row to row behind them. -->
                <View
                    android:id="@+id/panel_glide"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/glide_row"
                    android:visibility="invisible" />

                <LinearLayout
                    android:id="@+id/panel_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </FrameLayout>
        </com.thefactor1.player.ui.MaxHeightScrollView>

        <!-- What the focused row does, only on rows that need explaining. -->
        <TextView
            android:id="@+id/panel_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/ink_dim"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Skips while the controls are hidden: a glyph on the side that was pressed, and a slim progress line. -->
    <FrameLayout
        android:id="@+id/skip_back"
        style="@style/SkipGlyph"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="56dp">

        <ImageView
            android:layout_width="@dimen/skip_ring"
            android:layout_height="@dimen/skip_ring"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_skip_back" />

        <TextView
            android:id="@+id/skip_back_amount"
            style="@style/SkipAmount" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/skip_forward"
        style="@style/SkipGlyph"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="56dp">

        <ImageView
            android:layout_width="@dimen/skip_ring"
            android:layout_height="@dimen/skip_ring"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_skip_forward" />

        <TextView
            android:id="@+id/skip_forward_amount"
            style="@style/SkipAmount" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/mini_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:background="@drawable/scrim_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="51dp"
        android:paddingTop="56dp"
        android:paddingEnd="64dp"
        android:paddingBottom="22dp"
        android:visibility="invisible">

        <com.thefactor1.player.ui.SeekBarView
            android:id="@+id/mini_seek"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:focusable="false" />

        <TextView
            android:id="@+id/mini_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Play and pause with the controls hidden: a glyph that pops and fades in the middle. -->
    <ImageView
        android:id="@+id/center_glyph"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/glyph_bg"
        android:importantForAccessibility="no"
        android:padding="30dp"
        android:src="@drawable/ic_pause"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/center_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/toast_bg"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:visibility="invisible" />

    <!-- Skip intro / recap / credits: bottom right, like a streaming app; OK presses it while it shows. -->
    <TextView
        android:id="@+id/skip_prompt"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="64dp"
        android:alpha="0"
        android:background="@drawable/skip_prompt_bg"
        android:elevation="6dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:textColor="@color/on_focus"
        android:textSize="17sp"
        android:visibility="invisible" />

    <!-- "Back again to exit": small and quiet in the corner, not a box in the middle of the film. -->
    <TextView
        android:id="@+id/exit_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="36dp"
        android:alpha="0"
        android:shadowColor="#CC000000"
        android:shadowRadius="8"
        android:text="@string/toast_back_to_exit"
        android:textColor="@color/ink_dim"
        android:textSize="14sp"
        android:visibility="invisible" />

    <!-- Phones only: brightness or volume while a swipe changes it, a small pill at the top. -->
    <LinearLayout
        android:id="@+id/touch_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:alpha="0"
        android:background="@drawable/toast_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/touch_level_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume"
            android:tint="@color/ink" />

        <com.thefactor1.player.ui.SeekBarView
            android:id="@+id/touch_level_bar"
            android:layout_width="132dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:focusable="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/stats_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="32dp"
        android:background="@drawable/stats_background"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp"
        android:padding="16dp"
        android:textColor="#D7DBE0"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- The meta screen: loading card before playback, pause screen after a while paused. -->
    <FrameLayout
        android:id="@+id/loading_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loading_ground">

        <ImageView
            android:id="@+id/meta_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/meta_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/meta_scrim" />

        <TextView
            android:id="@+id/meta_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="72dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/meta_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="72dp"
            android:layout_marginEnd="72dp"
            android:layout_marginBottom="88dp"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meta_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:textColor="@color/ink_dim"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/meta_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:maxWidth="440dp"
                android:maxHeight="120dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/loading_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:maxWidth="760dp"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/meta_episode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxWidth="640dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/meta_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.2"
                android:maxWidth="600dp"
                android:maxLines="3"
                android:textColor="@color/ink_soft"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- X-Ray on the pause screen. -->
            <LinearLayout
                android:id="@+id/meta_cast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:visibility="gone" />

            <com.thefactor1.player.ui.SweepLineView
                android:id="@+id/loading_spinner"
                android:layout_width="220dp"
                android:layout_height="3dp"
                android:layout_marginTop="26dp" />

            <TextView
                android:id="@+id/loading_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxWidth="760dp"
                android:text="@string/loading_connecting"
                android:textColor="@color/ink_dim"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/error_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_retry"
                    style="@style/ControlButton"
                    android:nextFocusLeft="@id/btn_retry"
                    android:text="@string/action_retry" />

                <TextView
                    android:id="@+id/btn_other_player"
                    style="@style/ControlButton"
                    android:layout_marginEnd="0dp"
                    android:nextFocusRight="@id/btn_other_player"
                    android:text="@string/action_other_player" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/loading_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="72dp"
            android:layout_marginBottom="40dp"
            android:textColor="@color/ink_faint"
            android:textSize="13sp" />

        <!-- The pre-show, in place of the meta block while a stream loads: logo, a projection log
             of what was found, and a cue mark that fills as the stream buffers. -->
        <FrameLayout
            android:id="@+id/booth"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <com.thefactor1.player.ui.CueMarkView
                android:id="@+id/booth_cue"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="72dp" />

            <LinearLayout
                android:id="@+id/booth_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/booth_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:maxWidth="460dp"
                    android:maxHeight="110dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/booth_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:maxWidth="760dp"
                    android:maxLines="2"
                    android:textColor="@color/ink"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/booth_kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/booth_episode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxWidth="760dp"
                    android:maxLines="1"
                    android:textColor="@color/ink_soft"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <!-- A fixed width, so the block doesn't shift while lines type in. -->
                <LinearLayout
                    android:id="@+id/booth_log"
                    android:layout_width="620dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/booth_status"
                    android:layout_width="620dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:maxLines="1"
                    android:textColor="@color/ink_faint"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>

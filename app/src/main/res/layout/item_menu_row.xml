<?xml version="1.0" encoding="utf-8"?>
<!-- One line of a player menu: name on the left, its value, state or format on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:background="@drawable/panel_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/item_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/row_label"
        android:textSize="17sp" />

    <!-- Only on rows Left and Right can change, and only while focused. -->
    <ImageView
        android:id="@+id/item_less"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:rotation="180"
        android:src="@drawable/ic_chevron"
        android:tint="@color/row_arrow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/item_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:duplicateParentState="true"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/row_detail"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/item_more"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        android:tint="@color/row_arrow"
        android:visibility="gone" />

    <com.thefactor1.player.ui.SwitchMark
        android:id="@+id/item_switch"
        android:layout_width="32dp"
        android:layout_height="19dp"
        android:layout_marginStart="12dp"
        android:duplicateParentState="true"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/item_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        android:tint="@color/row_label"
        android:visibility="gone" />
</LinearLayout>

# Required: your AIOStreams manifest URL (from the AIOStreams configure page, "Copy URL").
AIOSTREAMS_URL=https://aiostreams.example.com/stremio/your-uuid/your-config/manifest.json

# Required: the login your IPTV app will use. Pick a real password.
XTREAM_USER=me
XTREAM_PASS=change-me

# Optional
# PUBLIC_URL=https://bridge.example.com   # address IPTV apps reach this server at, if behind a proxy
# CATALOG_ADDONS=https://another-addon/manifest.json   # extra catalog addons, comma separated
# CATALOG_PAGES=2
# PROXY_STREAMS=auto   # auto | always | never
# CONTAINER_EXT=mp4
